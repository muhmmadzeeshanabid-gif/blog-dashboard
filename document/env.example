# Sanity Configuration (CMS)
NEXT_PUBLIC_SANITY_PROJECT_ID=your_sanity_project_id
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01

# Sanity Read Token (public/safe for frontend)
NEXT_PUBLIC_SANITY_READ_TOKEN=your_sanity_read_token

# Sanity Write Token (server-side only - DO NOT expose to frontend)
SANITY_WRITE_TOKEN=your_sanity_write_token

# Supabase Keys (Database & Auth)
NEXT_PUBLIC_SUPABASE_URL=https://your_project_ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_public_key

# Supabase Service Role Key (server-side admin key - DO NOT expose to frontend)
# Used for backend dashboard operations that bypass RLS (Row Level Security)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
